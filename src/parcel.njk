---
layout: base.njk
pagination:
  data: visibleParcels
  size: 1
  alias: parcel
permalink: "dzialka-budowlana-249-{{ parcel.number }}.html"
eleventyComputed:
  title: "{{ parcel.seo.pageTitle }}"
  metaDescription: "{{ parcel.seo.metaDescription }}"
  canonical: "{{ site.siteUrl }}/dzialka-budowlana-249-{{ parcel.number }}.html"
  ogImage: "{{ parcel.seo.ogImage }}"
  heading: "{{ parcel.seo.pageTitle }} — {{ parcel.area }} m²"
---
{% include "parcel-card.njk" %}

{% if parcel.id == "249.1" %}
<section class="info developer-teaser">
    <p><strong>Okazja dla developera:</strong> tę działkę można połączyć z sąsiednimi działkami 83/3 i 83/5, uzyskując grunt pod budowę dwóch domów dwulokalowych (4 lokale). <a href="oferta-dla-developera.html">Zobacz szczegóły tej oferty &rarr;</a></p>
</section>
{% endif %}

{% set genericDescription = false %}
{% include "info-section.njk" %}

<section class="info description">
    <h2 class="info-title">Opis działki</h2>
    {% set descriptionInclude = parcel.descriptionFile | descriptionInclude %}
    {% if descriptionInclude %}
    {% include descriptionInclude %}
    {% elif parcel.description and parcel.description.length %}
    {% for para in parcel.description %}
    <p>{{ para | safe }}</p>
    {% endfor %}
    {% else %}
    <p class="description-placeholder">Szczegółowy opis tej działki pojawi się wkrótce.</p>
    {% endif %}
</section>

{% set nav = parcelNav[parcel.number] %}
<nav class="plot-nav">
    <a href="dzialka-budowlana-249-{{ nav.prev.number }}.html" class="reset-contra plot-nav-prev">&larr; Działka 249/{{ nav.prev.number }}</a>
    <a href="index.html" class="reset-contra plot-nav-home">Strona główna</a>
    <a href="dzialka-budowlana-249-{{ nav.next.number }}.html" class="reset-contra plot-nav-next">Działka 249/{{ nav.next.number }} &rarr;</a>
</nav>
